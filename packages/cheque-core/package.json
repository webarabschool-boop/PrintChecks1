{
  "name": "@printchecks/cheque-core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure, framework-agnostic cheque domain core: Bank / BankAccount / ChequeBook / Cheque, cheque-number sequence engine, Money, lifecycle state machine, repository ports and application use cases.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "import": "./dist/domain/index.mjs",
      "require": "./dist/domain/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "import": "./dist/ports/index.mjs",
      "require": "./dist/ports/index.js"
    },
    "./application": {
      "types": "./dist/application/index.d.ts",
      "import": "./dist/application/index.mjs",
      "require": "./dist/application/index.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "import": "./dist/infrastructure/index.mjs",
      "require": "./dist/infrastructure/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cheque",
    "check",
    "banking",
    "domain",
    "ddd",
    "printchecks"
  ],
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.4",
    "vitest": "^3.0.0"
  }
}
